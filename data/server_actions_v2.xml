<?xml version="1.0" encoding="utf-8"?>
<!-- BugFix-Maintenance v17.0.0.0.6: 12 truly-new server actions.
     Zero verified duplicates - all 12 are Studio-created
     MR/MNT_REQ maintenance workflow (planning/in-progress/
     repaired/scraped + MR create from maintenance request). -->
<odoo>

  <record id="server_action_1640_mnt_req_inprogress" model="ir.actions.server">
    <field name="name">MNT_REQ_inprogress</field>
    <field name="model_id" search="[('model', '=', 'maintenance.request')]"/>
    <field name="state">object_write</field>
    <field name="usage">ir_actions_server</field>
    <field name="update_field_id" ref="maintenance.field_maintenance_request__stage_id"/>
    <field name="value">2</field>
  </record>

  <record id="server_action_1638_mnt_req_planing" model="ir.actions.server">
    <field name="name">MNT_REQ_planing</field>
    <field name="model_id" search="[('model', '=', 'maintenance.request')]"/>
    <field name="state">object_write</field>
    <field name="usage">ir_actions_server</field>
    <field name="update_field_id" ref="maintenance.field_maintenance_request__stage_id"/>
    <field name="value">5</field>
  </record>

  <record id="server_action_1642_mnt_req_repaired" model="ir.actions.server">
    <field name="name">MNT_REQ_repaired</field>
    <field name="model_id" search="[('model', '=', 'maintenance.request')]"/>
    <field name="state">object_write</field>
    <field name="usage">ir_actions_server</field>
    <field name="update_field_id" ref="maintenance.field_maintenance_request__stage_id"/>
    <field name="value">3</field>
  </record>

  <record id="server_action_1644_mnt_req_scraped" model="ir.actions.server">
    <field name="name">MNT_REQ_scraped</field>
    <field name="model_id" search="[('model', '=', 'maintenance.request')]"/>
    <field name="state">object_write</field>
    <field name="usage">ir_actions_server</field>
    <field name="update_field_id" ref="maintenance.field_maintenance_request__stage_id"/>
    <field name="value">4</field>
  </record>

  <record id="server_action_2322_mr_maintenance_repaired" model="ir.actions.server">
    <field name="name">MR - Maintenance Repaired</field>
    <field name="model_id" search="[('model', '=', 'maintenance.request')]"/>
    <field name="state">object_write</field>
    <field name="usage">ir_actions_server</field>
    <field name="update_field_id" ref="maintenance.field_maintenance_request__stage_id"/>
    <field name="value">3</field>
  </record>

  <record id="server_action_2324_mr_maintenance_scrap" model="ir.actions.server">
    <field name="name">MR - Maintenance Scrap</field>
    <field name="model_id" search="[('model', '=', 'maintenance.request')]"/>
    <field name="state">object_write</field>
    <field name="usage">ir_actions_server</field>
    <field name="update_field_id" ref="maintenance.field_maintenance_request__stage_id"/>
    <field name="value">4</field>
  </record>

  <record id="server_action_2326_mr_create_mr_from_maintenance_request" model="ir.actions.server">
    <field name="name">MR - Create MR from Maintenance Request</field>
    <field name="model_id" search="[('model', '=', 'maintenance.request')]"/>
    <field name="state">code</field>
    <field name="usage">ir_actions_server</field>
    <field name="code"><![CDATA[if record.id: 
  
  mr = env['x_material_request'].create({'x_studio_many2one_field_THFu6':record.id, 'x_studio_journal_type':record.x_studio_journal_type_1.id})  
  
  action = {
            'name': 'RFQ',
            'domain': [('id', '=', mr.id)],
            'type': 'ir.actions.act_window',
            'res_model': 'x_material_request',
            'view_mode': 'tree,form',
            'view_type': 'form',
            'view_id': False,
            'context': False,
            } 


]]></field>
  </record>

  <record id="server_action_2318_mr_maintenance_in_progress" model="ir.actions.server">
    <field name="name">MR - Maintenance In progress</field>
    <field name="model_id" search="[('model', '=', 'maintenance.request')]"/>
    <field name="state">code</field>
    <field name="usage">ir_actions_server</field>
    <field name="code"><![CDATA[if record.id:
  if record.duration == False:
    raise UserError('Duration must be specified.')
    
  if record.user_id.id == False:
    raise UserError('Responsible user must be specified.')
    
  if record.schedule_date == False:
    raise UserError('Schedule date must be specified.')
    
  if record.x_studio_diagnosis_details == False:
    raise UserError('Diagnosis details must be specified.')  
    
    
  record.write({'stage_id':2})
  
  
    


]]></field>
  </record>

  <record id="server_action_2320_mr_maintenance_planning" model="ir.actions.server">
    <field name="name">MR - Maintenance Planning</field>
    <field name="model_id" search="[('model', '=', 'maintenance.request')]"/>
    <field name="state">code</field>
    <field name="usage">ir_actions_server</field>
    <field name="code"><![CDATA[if record.id:
  if record.priority == False:
    raise UserError('Priority level must be defined.')
    
  record.write({'stage_id':5})
  
  
    


]]></field>
  </record>

  <record id="server_action_1649_mr_create_for_mnt" model="ir.actions.server">
    <field name="name">MR create For MNT</field>
    <field name="model_id" search="[('model', '=', 'maintenance.request')]"/>
    <field name="state">code</field>
    <field name="usage">ir_actions_server</field>
    <field name="code"><![CDATA[env['x_material_request'].create({'x_studio_many2one_field_THFu6':record.id })

]]></field>
  </record>

  <record id="server_action_1646_mr_create_for_mnt" model="ir.actions.server">
    <field name="name">MR create For MNT</field>
    <field name="model_id" search="[('model', '=', 'maintenance.request')]"/>
    <field name="state">code</field>
    <field name="usage">ir_actions_server</field>
    <field name="code"><![CDATA[env['x_material_request'].create({'x_studio_many2one_field_THFu6':record.id })

]]></field>
  </record>

  <record id="server_action_1637_validate_maintenance_request" model="ir.actions.server">
    <field name="name">Validate Maintenance  Request</field>
    <field name="model_id" search="[('model', '=', 'maintenance.request')]"/>
    <field name="state">code</field>
    <field name="usage">base_automation</field>
    <field name="code"><![CDATA[if record.production_id.id:
  if record.maintenance_type == 'preventive':
    raise UserError('Preventive Maintenance Type is not Allowed for Manufacture Related Requests.')


]]></field>
  </record>

</odoo>
