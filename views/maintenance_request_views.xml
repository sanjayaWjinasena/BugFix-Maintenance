        <xpath expr="//field[@name='priority']" position="attributes">
          <attribute name="widget">radio</attribute>
        <attribute name="readonly">(stage_id == 4) or ((stage_id == 3) or ((stage_id == 2) or (stage_id == 5)))</attribute><attribute name="required">1</attribute></xpath>
        <xpath expr="//form[1]/sheet[1]/group[1]" position="after">
          <group name="studio_group_xZrL9">
            <group name="studio_group_xZrL9_left"/>
            <group name="studio_group_xZrL9_right"/>
          </group>
        </xpath>
        <xpath expr="//field[@name='description']" position="attributes">
          <attribute name="string">Diagnosis Details</attribute>
        <attribute name="invisible">1</attribute></xpath>
        <xpath expr="//field[@name='description']" position="after">
          <field name="x_studio_diagnosis_details" string="Diagnosis Details"/>
        </xpath>
      </data>
    </field>
  </record>
