<?xml version="1.0" encoding="utf-8"?>
<!-- BugFix-Maintenance v17.0.0.0.6: 5 Studio priority=99 view ports.
     Full pre-flight: xpath resolution against target composed
     arch, orphan x_* field strip (reverse-deps rule), modifier
     sentinel injection, numeric action ref conversion. -->
<odoo>

  <record id="ported_view_3254_odoo_studio_equipment_request_form_custo" model="ir.ui.view">
    <field name="name">Odoo Studio: equipment.request.form customization</field>
    <field name="model">maintenance.request</field>
    <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <data>
          <xpath expr="//sheet" position="inside">
            <field name="stage_id" invisible="1"/>
          </xpath>

        <xpath expr="//field[@name='employee_id']" position="replace">
          <field name="create_uid"/>
        </xpath>
        <xpath expr="//button[@name='archive_equipment_request']" position="attributes">
          <attribute name="studio_approval">False</attribute>
        </xpath>
        <xpath expr="//form[1]/sheet[1]/div[not(@name)][1]" position="before">
          <div name="button_box" class="oe_button_box">
            <!-- STRIPPED unresolved action 1648 --></div>
        </xpath>
        <xpath expr="//field[@name='name']" position="attributes">
          <attribute name="force_save">True</attribute>
          <attribute name="readonly">1</attribute></xpath>
        <xpath expr="//field[@name='equipment_id']" position="attributes">
          <attribute name="readonly">(stage_id == 4) or ((stage_id == 3) or ((stage_id == 2) or (stage_id == 5)))</attribute></xpath>
        <!-- DROPPED xpath: //field[@name='category_id'] --><xpath expr="//field[@name='maintenance_type']" position="attributes">
          <attribute name="readonly">(stage_id == 4) or ((stage_id == 3) or ((stage_id == 2) or (stage_id == 5)))</attribute></xpath>
        <xpath expr="//field[@name='production_id']" position="attributes">
          <attribute name="force_save">True</attribute>
          <attribute name="readonly">1</attribute></xpath>
        <!-- DROPPED xpath: //field[@name='workorder_id'] --><xpath expr="//field[@name='maintenance_team_id']" position="attributes">
          <attribute name="invisible">stage_id in [1]</attribute><attribute name="readonly">(stage_id == 4) or ((stage_id == 3) or (stage_id == 2))</attribute></xpath>
        <xpath expr="//field[@name='user_id']" position="attributes">
          <attribute name="invisible">stage_id in [1]</attribute><attribute name="readonly">(stage_id == 4) or ((stage_id == 3) or (stage_id == 2))</attribute></xpath>
        <xpath expr="//field[@name='user_id']" position="after">
          <field name="x_studio_float_field_hmeW9"/>
        </xpath>
        <xpath expr="//field[@name='schedule_date']" position="attributes">
          <attribute name="invisible">stage_id in [1]</attribute><attribute name="readonly">(stage_id == 4) or ((stage_id == 3) or (stage_id == 2))</attribute></xpath>
        <xpath expr="//field[@name='duration']" position="attributes">
          <attribute name="invisible">stage_id in [1]</attribute><attribute name="readonly">(stage_id == 4) or ((stage_id == 3) or (stage_id == 2))</attribute></xpath>
        <xpath expr="//field[@name='priority']" position="attributes">
          <attribute name="widget">radio</attribute>
        <attribute name="readonly">(stage_id == 4) or ((stage_id == 3) or ((stage_id == 2) or (stage_id == 5)))</attribute><attribute name="required">1</attribute></xpath>
        <xpath expr="//form[1]/sheet[1]/group[1]" position="after">
          <group name="studio_group_xZrL9">
            <group name="studio_group_xZrL9_left"/>
            <group name="studio_group_xZrL9_right"/>
          </group>
        </xpath>
        <xpath expr="//field[@name='description']" position="attributes">
          <attribute name="string">Diagnosis Details</attribute>
        <attribute name="invisible">1</attribute></xpath>
        <xpath expr="//field[@name='description']" position="after">
          <field name="x_studio_diagnosis_details" string="Diagnosis Details"/>
        </xpath>
      </data>
    </field>
  </record>

  <record id="ported_view_5072_equipment_request_form_button" model="ir.ui.view">
    <field name="name">equipment.request.form_Button</field>
    <field name="model">maintenance.request</field>
    <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <data>
          <xpath expr="//header/button[@name='archive_equipment_request']" position="after">
            <!-- STRIPPED unresolved action 2320 --></xpath>
          <!-- DROPPED xpath: //header/button[@name='2320'] --><!-- DROPPED xpath: //header/button[@name='2318'] --><!-- DROPPED xpath: //header/button[@name='2326'] --><!-- DROPPED xpath: //header/button[@name='2322'] --><xpath expr="//field[@name='stage_id']" position="attributes">
            <attribute name="options">{'clickable': False}</attribute>
          </xpath>
        </data>
    </field>
  </record>

  <record id="ported_view_5333_odoo_studio_equipment_category_form_cust" model="ir.ui.view">
    <field name="name">Odoo Studio: equipment.category.form customization</field>
    <field name="model">maintenance.equipment.category</field>
    <field name="inherit_id" ref="maintenance.hr_equipment_category_view_form"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//field[@name='technician_user_id']" position="after">
          <field name="x_studio_journal_type"/>
        </xpath>
      </data>
    </field>
  </record>

  <record id="ported_view_5332_odoo_studio_equipment_category_tree_cust" model="ir.ui.view">
    <field name="name">Odoo Studio: equipment.category.tree customization</field>
    <field name="model">maintenance.equipment.category</field>
    <field name="inherit_id" ref="maintenance.hr_equipment_category_view_tree"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//field[@name='technician_user_id']" position="after">
          <field optional="show" name="x_studio_journal_type" string="Journal Type"/>
        </xpath>
      </data>
    </field>
  </record>

  <record id="ported_view_5071_odoo_studio_equipment_stage_tree_customi" model="ir.ui.view">
    <field name="name">Odoo Studio: equipment.stage.tree customization</field>
    <field name="model">maintenance.stage</field>
    <field name="inherit_id" ref="maintenance.hr_equipment_stage_view_tree"/>
    <field name="priority">99</field>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//field[@name='done']" position="after">
          <field name="id" optional="show"/>
        </xpath>
      </data>
    </field>
  </record>

</odoo>
